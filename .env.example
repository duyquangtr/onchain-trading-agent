# Example environment file. Copy to `.env` (which is git-ignored) and fill in
# your own values. This file holds ONLY placeholder names, never real secrets.
#
# Golden rule (see AGENTS.md): never commit a real key, mnemonic, API key, or an
# RPC URL that contains an API key. gitleaks checks this on every pull request.

# --- Contracts (M1a): nothing is required yet ---------------------------------
# Local tests and `forge test` need no secrets at all. The values below are only
# needed later (M4) when you deploy to a public testnet.

# Testnet RPC endpoints (use the plain public URLs, or your own without a key).
BASE_SEPOLIA_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=
SEPOLIA_RPC_URL=

# The deployer key is NOT stored here. Import it once into Foundry's encrypted
# keystore instead:  cast wallet import deployer --interactive
# Then deploy with:  forge script ... --account deployer

# Etherscan/Basescan API key, used only to verify a deployed contract (M4).
ETHERSCAN_API_KEY=
